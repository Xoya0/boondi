# ==============================================================================
# Boondi Production Environment Configuration Template
# Copy this file to '.env' on your production server and fill in the values.
# ==============================================================================

# Database Settings
# Generate a strong password for your database
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD

# Redis Settings
# Generate a strong password for Redis
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD

# Security Settings
# Generate a 256-bit+ key using: openssl rand -base64 64
JWT_SECRET=YOUR_JWT_SECRET

# MinIO Settings
# Set access username and a strong password for object storage
MINIO_ROOT_USER=boondi_admin
MINIO_ROOT_PASSWORD=YOUR_STRONG_MINIO_PASSWORD

# Mail Settings (Optional/SMTP Provider)
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_mail_password

# Public Reachable URLs
# The URL pointing to your MinIO public endpoint (or your domain/minio if proxied)
STORAGE_PUBLIC_URL=https://boondi.duckdns.org/minio-media

# Frontend CORS & Backend Base URLs
CORS_ORIGINS=https://boondi.duckdns.org
APP_BASE_URL=https://boondi.duckdns.org

# Admin Emails
# Comma-separated emails to auto-promote to ADMIN on startup
ADMIN_EMAILS=your-admin-email@example.com
